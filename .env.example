# Base URL of the platform backend API (no trailing slash).
NEXT_PUBLIC_API_URL=https://ecommerce-backend-eta-one.vercel.app
# Public URL of THIS storefront once deployed (used for canonical
# URLs, sitemap and social cards). Set it to the real domain on Vercel.
NEXT_PUBLIC_SITE_URL=https://your-storefront-domain.vercel.app
# Fallback store name used only until the name is set in the admin
# panel (Settings → General). The panel value wins when present.
NEXT_PUBLIC_STORE_NAME=
